# Copia este fichero como .env en la carpeta del stack (en el NAS) y rellénalo. No lo subas a GitHub.
# Las cuentas, invitaciones y las fuentes de cada usuario se guardan en la base de datos, no aquí.

# ---- contenedor (docker/compose.yml) ----
IMAGE_REPOSITORY=jaimetur/bodylens
IMAGE_TAG=latest
CONTAINER_NAME=bodylens
APP_PORT=7280
HOST_DATA_DIR=/volume1/docker/data/bodylens
# usuario y grupo con los que corre el servidor: necesitan permiso de escritura en HOST_DATA_DIR
# (en el NAS, las ACL de /volume1/docker dan escritura al grupo docker_users: docker_limited = 1034, docker_users = 65544)
PUID=1034
PGID=65544

# ---- aplicación ----
TZ=Europe/Madrid
# dirección pública (para los enlaces de invitación), sin barra final
PUBLIC_URL=https://bodylens.example.com
# cuenta de administración que se crea sola al arrancar con la base vacía; al entrar la primera vez
# se pide cambiar la contraseña (y se puede cambiar el usuario y el nombre)
BODYLENS_ADMIN_USER=jaime
BODYLENS_ADMIN_NAME=Jaime Tur
BODYLENS_ADMIN_PASSWORD=bodylens
# minutos entre sincronizaciones automáticas
SYNC_INTERVAL_MIN=15
# días que dura la sesión y una invitación
SESSION_DAYS=90
INVITE_DAYS=7

# ---- fase 1: puente con Google (la hoja de cada cuenta se configura en «Tu cuenta», como admin) ----
# clave JSON de la cuenta de servicio de Google (dentro del contenedor)
GOOGLE_SERVICE_ACCOUNT_JSON=/data/secrets/google-sa.json

# ---- fase 2 (todavía no se usa): Withings ----
WITHINGS_CLIENT_ID=
WITHINGS_CLIENT_SECRET=
