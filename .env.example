# Copia este fichero a .env en el servidor y rellénalo. No lo subas a GitHub.
TZ=Europe/Madrid
PUBLIC_URL=https://bodylens.example.com
BODYLENS_PASSWORD_HASH=
SECRET_KEY=
SYNC_INTERVAL_MIN=15

# Fase 1: puente con Google (la hoja sigue siendo la fuente)
APPS_SCRIPT_SYNC_URL=https://script.google.com/macros/s/AKfycbyq4X7M4IRxqFM7ez4BYQ9SelLUPo1Wauc9zm4YgCfD8wubBL-rVKe5rytquF4D-7Ac/exec?accion=sincronizar
GOOGLE_SHEET_ID=1aUMgruI3VycOCjbqH4_UvL8nS8i-mt1QFNiz6xaQx2Q
GOOGLE_SERVICE_ACCOUNT_JSON=/data/secrets/google-sa.json

# Fase 2: el servidor habla directamente con Withings y recibe Health Auto Export
WITHINGS_CLIENT_ID=
WITHINGS_CLIENT_SECRET=
WITHINGS_REDIRECT_URI=https://bodylens.example.com/oauth/withings/callback
HAE_TOKEN=
